# The site's real production domain. Canonical URLs, Open Graph/Twitter
# share tags, the sitemap, robots.txt and structured data all use this.
# Falls back to https://oneforge.org if unset.
NEXT_PUBLIC_SITE_URL=https://oneforge.org

# Google Search Console site-verification token (Settings > Ownership
# verification > HTML tag > the "content" value only, not the full tag).
# Leave unset until there's a Search Console property to verify.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Form delivery (the Say hello and partner forms): set at least one. In production the forms return 503 if none is set.
# Email via Resend (https://resend.com):
RESEND_API_KEY=
CONNECT_FROM_EMAIL="ONEFORGE <hello@your-verified-domain>"
CONNECT_TO_EMAIL=hello@oneforge.org
# Where the /partner page's "Let us say thank you" form goes (defaults to boye.oloyede@oneforge.org):
PARTNER_TO_EMAIL=boye.oloyede@oneforge.org
# Who Boye's thank-you email to givers comes from (replies go to Boye either way). Using a
# @oneforge.org address needs oneforge.org verified in Resend. Falls back to CONNECT_FROM_EMAIL.
PARTNER_FROM_EMAIL="Boye Oloyede <boye.oloyede@oneforge.org>"
# Google Sheet: every entry from both forms is also saved as a row, one tab per form.
# Paste the Apps Script web app URL (ends in /exec). Setup steps: integrations/google-sheet.gs
SHEETS_WEBHOOK_URL=
# Or a webhook (Slack/Zapier/Make) that accepts JSON POST:
CONNECT_WEBHOOK_URL=
