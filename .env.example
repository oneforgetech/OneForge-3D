# The site's real production domain. Canonical URLs, Open Graph/Twitter
# share tags, the sitemap, robots.txt and structured data all use this.
# Falls back to https://oneforge.org if unset.
NEXT_PUBLIC_SITE_URL=https://oneforge.org

# Google Search Console site-verification token (Settings > Ownership
# verification > HTML tag > the "content" value only, not the full tag).
# Leave unset until there's a Search Console property to verify.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Contact form delivery — set ONE OR BOTH. In production the form returns 503 if neither is set.
# Email via Resend (https://resend.com):
RESEND_API_KEY=
CONNECT_FROM_EMAIL="ONEFORGE <hello@your-verified-domain>"
CONNECT_TO_EMAIL=hello@oneforge.org
# Or a webhook (Slack/Zapier/Make/Apps Script) that accepts JSON POST:
CONNECT_WEBHOOK_URL=
